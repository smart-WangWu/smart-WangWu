.agreement-page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.agreement-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.agreement-section {
  margin-bottom: 36rpx;
}

.agreement-section:last-child {
  margin-bottom: 0;
}

.agreement-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.agreement-update {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.section-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  display: block;
  margin-bottom: 12rpx;
}

.section-text:last-child {
  margin-bottom: 0;
}
