.mine-page {
  min-height: 100vh;
  background-color: #f5f7fb;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部：整体浅青绿横向渐变（左浅右深），覆盖整块区域 */
.mine-header {
  padding: 40rpx 24rpx 72rpx;
  min-height: 200rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  background: linear-gradient(90deg, #e0f5f2 0%, #b8e6e0 45%, #8dd5ce 100%);
}

/* 用户信息卡片：无单独背景，沿用整体渐变 */
.user-info-card {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 32rpx 0 36rpx;
  margin: 0;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
}

.user-card-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.user-card-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #c0c0c0;
  display: block;
}

.user-card-edit {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid #7ed0c8;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-card-edit-arrow {
  font-size: 26rpx;
  color: #5eb8b0;
  font-weight: 600;
}

.user-card-info {
  margin-left: 28rpx;
  flex: 1;
  min-width: 0;
}

.user-card-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #000000;
  line-height: 1.3;
}

.mine-header-top {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 28rpx;
}

.mine-header-spacer {
  width: 40rpx;
  height: 40rpx;
}

.mine-header-icons {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.mine-bell {
  font-size: 40rpx;
  color: #ff8a3c;
}

/* 通用卡片容器 */
.mine-section {
  margin: -60rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* 顶部四个快捷入口卡片 */
.mine-shortcut-section {
  margin-top: -40rpx;
  padding: 26rpx 26rpx 30rpx;
  display: flex;
  justify-content: space-between;
}

.shortcut-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.shortcut-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.shortcut-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.shortcut-text {
  font-size: 24rpx;
  color: #555555;
}

/* 列表区 */
.mine-list-section {
  margin-top: 18rpx;
  padding: 8rpx 0;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 26rpx;
}

.list-item + .list-item {
  border-top: 1rpx solid #f2f2f2;
}

.list-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.list-icon {
  font-size: 32rpx;
}

.list-text {
  font-size: 28rpx;
  color: #333333;
}

.list-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.list-extra {
  font-size: 24rpx;
  color: #999999;
}

.list-arrow {
  font-size: 32rpx;
  color: #c7c7cc;
}

/* 修改昵称弹窗 */
.nickname-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.nickname-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 24rpx;
  z-index: 1001;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.nickname-modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.nickname-modal-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.nickname-modal-btns {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.nickname-modal-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.nickname-modal-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.nickname-modal-btn.confirm {
  background: linear-gradient(90deg, #b8e6e0, #8dd5ce);
  color: #333;
}

