.container {
  background-color: #f7f9fc;
  background-image: url("https://youke.xn--y7xa690gmna.cn/s1/2026/01/27/697860dbcfb5c.webp");
  background-repeat: no-repeat;
  background-position: center top;
  background-size: cover;
  min-height: 100vh;
  padding: 15rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  margin-bottom: 4rpx;
}

/* 与首页「今日景区客流」一致的标题装饰（同底图） */
.title-decoration-wrapper {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  min-height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: visible;
  margin: 0 auto;
}

.title-decoration-img {
  width: 100%;
  max-width: 640rpx;
  height: 72rpx;
  display: block;
  border-radius: 14rpx;
}

.title-decoration-text {
  position: absolute;
  font-size: 42rpx;
  font-weight: bold;
  color: #000000;
  text-align: center;
  white-space: nowrap;
  z-index: 10;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.card {
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08);
  overflow: hidden;
}

/* 景点图片样式 */
.scenery-image {
  width: 100%;
  height: 450rpx;
  display: block;
}

/* 景点信息样式 */
.info {
  padding: 30rpx;
}
.name {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
  margin-bottom: 20rpx;
}
.description {
  font-size: 30rpx;
  line-height: 1.6;
  color: #555;
  display: block;
  margin-bottom: 25rpx;
}
.meta {
  font-size: 28rpx;
  color: #7f8c8d;
}
