.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 统计条 */
.stat-bar {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
  padding: 28rpx 32rpx 20rpx;
  background: #ffffff;
  margin-bottom: 20rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff6633;
}

.stat-label {
  font-size: 26rpx;
  color: #999999;
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  background: #ffffff;
  margin: 0 24rpx;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 40rpx;
  text-align: center;
}

.empty-btn {
  padding: 20rpx 60rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(90deg, #ff8833, #ff5522);
  border-radius: 999rpx;
}

/* 评论列表 */
.review-list {
  padding: 0 24rpx;
}

.review-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.review-merchant {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 14rpx;
}

.review-merchant-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: #e8e8e8;
  flex-shrink: 0;
}

.review-merchant-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.review-merchant-arrow {
  font-size: 36rpx;
  color: #cccccc;
}

.review-body {
  padding: 20rpx 24rpx;
}

.review-score-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.review-stars {
  display: flex;
  flex-direction: row;
  gap: 4rpx;
}

.rstar {
  font-size: 26rpx;
  color: #d8d8d8;
}

.rstar--on {
  color: #ff6633;
}

.review-mood {
  font-size: 24rpx;
  color: #ff6633;
  background: rgba(255, 102, 51, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.review-date {
  font-size: 24rpx;
  color: #bbbbbb;
  margin-left: auto;
}

.review-content {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  line-clamp: 4;
  overflow: hidden;
}

.review-pics {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.review-pic {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  background: #e8e8e8;
}

.review-footer {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  padding: 0 24rpx 16rpx;
}

.review-del {
  font-size: 26rpx;
  color: #999999;
  padding: 8rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.safe-bottom {
  height: calc(32rpx + env(safe-area-inset-bottom));
}
