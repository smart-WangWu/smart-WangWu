<view class="page">
  <view class="empty" wx:if="{{list.length === 0}}">
    <text class="empty-icon">👍</text>
    <text class="empty-text">暂无点赞内容</text>
    <text class="empty-hint">点赞后将在此展示</text>
  </view>
  <view class="list" wx:else>
    <view class="item" wx:for="{{list}}" wx:key="id">{{item}}</view>
  </view>
</view>
