/* 王屋山美食推荐列表页 — 白色主体 + 大众点评橙 + 浅米白卡片 */

page {
  background-color: #ffffff;
}

.food-page {
  min-height: 100vh;
  background-color: #ffffff;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ========== 1. 头部标题栏 ========== */
.page-section-head {
  padding: 36rpx 0 28rpx;
  border-bottom: 1rpx solid #e8e8e8;
  margin: 0 30rpx;
  box-sizing: border-box;
}

.page-section-head-text {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

/* ========== 2. 卡片列表 ========== */
.card-list {
  padding: 30rpx 30rpx 0;
  box-sizing: border-box;
}

.merchant-card {
  margin-bottom: 30rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: #faf7f2;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0ebe4;
}

.merchant-card--active {
  opacity: 0.92;
  transform: scale(0.998);
}

.card-cover-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  border-radius: 24rpx 24rpx 0 0;
}

.card-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-cover-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  box-sizing: border-box;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.15;
  color: #ffffff;
  text-align: center;
  letter-spacing: 4rpx;
  /* 多层描边式阴影，保证任意背景上可读 */
  text-shadow:
    0 0 2rpx rgba(0, 0, 0, 1),
    0 2rpx 6rpx rgba(0, 0, 0, 0.95),
    0 6rpx 20rpx rgba(0, 0, 0, 0.85),
    0 0 24rpx rgba(0, 0, 0, 0.55);
}

.card-cover-meta {
  position: absolute;
  right: 0;
  bottom: 0;
  padding: 10rpx 20rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 16rpx 0 0 0;
}

.card-cover-meta-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
}

.card-body {
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #faf7f2;
}

.card-row-title {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.card-name-full {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.35;
}

.card-sep {
  font-size: 24rpx;
  color: #999999;
  margin: 0 10rpx;
}

.card-loc {
  font-size: 24rpx;
  color: #888888;
  flex: 1;
  min-width: 0;
}

.card-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-word;
  font-size: 26rpx;
  line-height: 1.55;
  color: #666666;
  margin-bottom: 16rpx;
  /* 双保险：约 2 行（26rpx × 1.55 × 2） */
  max-height: 82rpx;
}

.card-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.card-tag {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #2e7d32;
  background-color: #e8f5e9;
  font-weight: 500;
}

.card-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.card-price {
  font-size: 52rpx;
  font-weight: 900;
  color: #ff6633;
  letter-spacing: 1rpx;
  line-height: 1.1;
}

.card-btn-detail {
  flex-shrink: 0;
  padding: 18rpx 40rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff6633 0%, #ff7a3d 50%, #ff8a50 100%);
  box-shadow: 0 6rpx 16rpx rgba(255, 102, 51, 0.45);
}

.card-btn-detail--active {
  opacity: 0.88;
}

.card-btn-detail-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

