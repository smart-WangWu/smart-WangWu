.page { min-height: 100vh; background: #f5f7fb; padding: 32rpx; box-sizing: border-box; }
.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; opacity: 0.6; }
.empty-text { font-size: 30rpx; color: #333; margin-bottom: 12rpx; }
.empty-hint { font-size: 24rpx; color: #999; }
