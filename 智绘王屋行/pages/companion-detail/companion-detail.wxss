/* 随行客图文详情页 - 微博/小红书风格 */
.detail-page {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* 图片轮播区域 */
.image-swiper {
  width: 100%;
  height: 520rpx;
  background: #f5f5f5;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 图片计数 */
.image-count {
  position: absolute;
  right: 24rpx;
  bottom: 200rpx;
  background: rgba(0, 0, 0, 0.5);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.count-text {
  font-size: 22rpx;
  color: #fff;
}

/* 内容区域 */
.content-area {
  padding: 28rpx;
}

/* 标题 */
.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.5;
  display: block;
  margin-bottom: 24rpx;
}

/* 作者信息 */
.author-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.author-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.author-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.author-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.author-badge {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-icon {
  font-size: 18rpx;
  color: #fff;
  font-weight: 700;
}

.publish-time {
  font-size: 22rpx;
  color: #999;
}

.author-right {
  flex-shrink: 0;
}

.follow-btn {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  border-radius: 32rpx;
  border: none;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.follow-btn.followed {
  background: #f5f5f5;
  color: #999;
}

.follow-hover {
  opacity: 0.85;
}

.follow-text {
  color: #fff;
  font-size: 24rpx;
}

.follow-btn.followed .follow-text {
  color: #999;
}

/* 正文内容 */
.main-content {
  margin-bottom: 24rpx;
}

.content-text {
  font-size: 30rpx;
  color: #444;
  line-height: 1.8;
  display: block;
}

/* 地点标签 */
.location-section {
  margin-bottom: 24rpx;
}

.location-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: #f0f7ff;
  border-radius: 24rpx;
}

.location-icon {
  font-size: 26rpx;
}

.location-text {
  font-size: 24rpx;
  color: #4070d8;
}

/* 互动数据栏 */
.stats-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 24rpx;
}

.stat-icon {
  font-size: 36rpx;
  color: #999;
}

.stat-icon.active {
  color: #ff4757;
  animation: heartPop 0.3s ease;
}

@keyframes heartPop {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.stat-num {
  font-size: 26rpx;
  color: #666;
}

.stat-divider {
  width: 1rpx;
  height: 32rpx;
  background: #e5e5e5;
}

/* 评论区标题 */
.comment-section-header {
  margin-bottom: 24rpx;
}

.comment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 评论区列表 */
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
}

.comment-left {
  flex-shrink: 0;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.comment-right {
  flex: 1;
  min-width: 0;
}

.comment-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #4070d8;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.comment-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.comment-like {
  font-size: 24rpx;
  color: #999;
}

.comment-like.active {
  color: #ff4757;
}

.comment-reply {
  font-size: 24rpx;
  color: #999;
}

/* 子评论 */
.sub-comment-list {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 8rpx;
}

.sub-comment-item {
  margin-bottom: 12rpx;
}

.sub-comment-item:last-child {
  margin-bottom: 0;
}

.sub-name {
  font-size: 24rpx;
  color: #4070d8;
  font-weight: 500;
  margin-right: 8rpx;
}

.sub-content {
  font-size: 24rpx;
  color: #444;
}

/* 空评论提示 */
.empty-comment {
  padding: 40rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.bottom-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.input-hint {
  font-size: 26rpx;
  color: #999;
}

.bottom-actions {
  display: flex;
  gap: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
}

.action-icon {
  font-size: 38rpx;
  color: #666;
}

.action-item.active .action-icon {
  color: #ff4757;
}

.action-text {
  font-size: 20rpx;
  color: #666;
}

/* 按钮样式重置 */
button {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: 1;
}

button::after {
  border: none;
}
