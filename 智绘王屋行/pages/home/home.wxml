<!-- 天气信息覆盖层 -->
<view class="weather-overlay">
  <view class="weather-content">
    <view class="weather-top">
      <text class="weather-temp">{{weather.tempRange}}</text>
      <text class="weather-separator">/</text>
      <text class="weather-icon">🌧️</text>
      <text class="weather-desc">{{weather.condition}}</text>
    </view>
    <view class="weather-title">
      <text class="weather-title-text">天气</text>
    </view>
    <view class="weather-info">
      <text class="weather-item">云海概率{{weather.cloudSeaProb}}%</text>
    </view>
    <view class="weather-bottom">
      <text class="weather-item">日出时间: {{weather.sunriseTime}}</text>
      <text class="weather-item">可见概率: {{weather.visibilityProb}}%</text>
    </view>
  </view>
</view>
<!-- 自定义分页点指示器 -->
<view class="custom-indicator">
  <block wx:for="{{imgUrls}}" wx:key="index">
    <view class="indicator-dot {{index === current ? 'active' : ''}}"></view>
  </block>
</view>
</view>
