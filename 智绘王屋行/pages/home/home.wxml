<!-- 核心景点展示 -->
<view class="scenery-showcase">
  <view class="showcase-header">
    <view class="header-left">
      <view class="diamond-icon"></view>
      <text class="header-title">核心景点</text>
      <view class="diamond-icon"></view>
    </view>
    <view class="header-right">
      <navigator url="/pages/onepage/onepage" class="more-link">全部 ></navigator>
    </view>
  </view>
  <scroll-view class="scenery-scroll" scroll-x="true" show-scrollbar="false">
    <view class="scenery-list">
      <view class="scenery-card" wx:for="{{sceneryList}}" wx:key="id">
        <view class="scenery-image-wrap">
          <image class="scenery-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="scenery-label">
            <text class="label-sep">| </text>
            <text class="scenery-name">{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

<!-- 预定民宿入口 -->
<view class="homestay-preview">
  <view class="showcase-header">
    <view class="header-left">
      <view class="diamond-icon"></view>
      <text class="header-title">民宿推荐</text>
      <view class="diamond-icon"></view>
    </view>
    <view class="header-right">
      <navigator url="/pages/twopage/twopage" class="more-link">全部 ></navigator>
    </view>
  </view>

  <view class="homestay-preview-list">
    <navigator
      class="homestay-card-horizontal"
      url="/pages/homestay-detail/index?id={{item.id}}"
      wx:for="{{homestayPreviewList}}"
      wx:key="id"
    >
      <image class="homestay-card-img" src="{{item.image}}" mode="aspectFill"></image>
      <view class="homestay-card-content">
        <view class="homestay-card-header">
          <text class="homestay-card-name">{{item.name}}</text>
          <view class="homestay-card-tag">{{item.type}}</view>
        </view>
        <text class="homestay-card-desc">{{item.reason}}</text>
        <view class="homestay-card-footer">
          <text class="homestay-card-price">¥{{item.price}}<text class="homestay-card-unit">/晚起</text></text>
          <view class="homestay-card-btn">去预订</view>
        </view>
      </view>
    </navigator>
  </view>
</view>

<!-- 高德地图显示智绘王屋风景区景点 -->
<view class="map-container">
  <text class="map-title">📍 智绘王屋风景区景点地图</text>
  <!-- 路线选择器 -->
  <view class="route-selector">
    <view class="route-tabs">
      <view class="route-tab {{currentRoute === 'walking' ? 'active' : ''}}" bindtap="switchRoute" data-route="walking">
        步行登山
      </view>
      <view class="route-tab {{currentRoute === 'cable-walk' ? 'active' : ''}}" bindtap="switchRoute" data-route="cable-walk">
        索道步行
      </view>
      <view class="route-tab {{currentRoute === 'cable-magic' ? 'active' : ''}}" bindtap="switchRoute" data-route="cable-magic">
        索道魔毯
      </view>
    </view>
  </view>
  <view class="map-wrapper">
    <map
      id="wangwushanMap"
      class="map"
      longitude="{{longitude}}"
      latitude="{{latitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      polyline="{{currentPolyline}}"
      circles="{{circles}}"
      subkey="{{tencentMapKey}}"
      show-location="{{true}}"
      enable-poi="{{true}}"
      enable-building="{{true}}"
      enable-3D="{{true}}"
      show-compass="{{true}}"
      show-scale="{{false}}"
      enable-zoom="{{true}}"
      enable-scroll="{{true}}"
      bindmarkertap="onMarkerTap"
      bindtap="onMapTap"
      bindregionchange="onRegionChange"
    ></map>
    <!-- 使用cover-view覆盖地图底部的logo和版权信息 -->
    <cover-view class="map-cover-bottom">
      <cover-text class="map-tip">📍 绿色圆点为起点，红色圆点为终点；民宿为红色标注点（图标）</cover-text>
    </cover-view>
    <!-- 自定义比例尺：文字在上，黑色横线两端竖线 -->
    <cover-view class="map-scale-bar">
      <cover-text class="map-scale-text">{{scaleLabel}}</cover-text>
      <cover-view class="map-scale-line-wrap">
        <cover-view class="map-scale-tick"></cover-view>
        <cover-view class="map-scale-line"></cover-view>
        <cover-view class="map-scale-tick"></cover-view>
      </cover-view>
    </cover-view>
  </view>
</view>