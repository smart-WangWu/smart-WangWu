  </swiper-item>
  <swiper-item>
  <image src="https://wang-img-bed.oss-cn-beijing.aliyuncs.com/img/%E9%81%93%E5%A2%83%E5%B9%BF%E5%9C%BA.jpg" class="poiulk"></image>
  </swiper-item>
  <swiper-item>
