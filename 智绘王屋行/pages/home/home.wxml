<!-- 自定义导航栏：左侧搜索栏 + 中间标题 + 右侧图标 -->
<view class="home-nav-custom" style="padding-top: {{statusBarHeight}}px;">
  <view class="home-nav-inner">
    <view class="home-search-bar" bindtap="onSearchTap">
      <text class="home-search-icon">🔍</text>
      <text class="home-search-placeholder">搜索景点、民宿</text>
    </view>
    <text class="home-nav-title">智绘王屋</text>
    <view class="home-nav-right">
      <view class="home-nav-icon" bindtap="onLocationTap">◎</view>
    </view>
  </view>
</view>
<view class="home-nav-placeholder" style="height: {{navBarHeight}}px;"></view>

<!-- 搜索浮层 -->
<view class="search-overlay" wx:if="{{searchShow}}" catchtap="onSearchClose">
  <view class="search-panel" catchtap="">
    <view class="search-panel-header">
      <view class="search-panel-input-wrap">
        <text class="search-panel-icon">🔍</text>
        <input class="search-panel-input" placeholder="搜索景点、民宿" value="{{searchKeyword}}" bindinput="onSearchInput" focus="{{searchShow}}" placeholder-class="search-placeholder"/>
      </view>
      <text class="search-panel-cancel" bindtap="onSearchClose">取消</text>
    </view>
    <scroll-view class="search-results" scroll-y>
      <block wx:if="{{searchKeyword.length > 0}}">
        <view class="search-section" wx:if="{{searchSceneryResults.length > 0}}">
          <text class="search-section-title">景点</text>
          <view class="search-result-item" wx:for="{{searchSceneryResults}}" wx:key="name" data-type="scenery" bindtap="onSearchResultTap">
            <text class="search-result-name">{{item.name}}</text>
          </view>
        </view>
        <view class="search-section" wx:if="{{searchHomestayResults.length > 0}}">
          <text class="search-section-title">民宿</text>
          <view class="search-result-item" wx:for="{{searchHomestayResults}}" wx:key="id" data-type="homestay" data-index="{{index}}" bindtap="onSearchResultTap">
            <text class="search-result-name">{{item.name}}</text>
            <text class="search-result-extra">{{item.type}} · ¥{{item.price}}/晚</text>
          </view>
        </view>
        <view class="search-empty search-empty-noresult" wx:if="{{searchSceneryResults.length === 0 && searchHomestayResults.length === 0}}">
          <text class="search-empty-icon">🔎</text>
          <text class="search-empty-text">未找到「{{searchKeyword}}」相关结果</text>
          <text class="search-empty-hint">试试其他关键词</text>
        </view>
      </block>
      <view class="search-empty search-empty-initial" wx:else>
        <text class="search-empty-icon">🔍</text>
        <text class="search-empty-text">输入景点或民宿名称进行搜索</text>
        <text class="search-empty-hint">支持按名称、类型、地址筛选</text>
      </view>
    </scroll-view>
  </view>
</view>

