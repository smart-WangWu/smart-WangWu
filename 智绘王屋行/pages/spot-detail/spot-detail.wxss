/* 景点详情页 */
/* 在线链接服务仅供平台体验和调试使用，企业客户需下载字体包自行发布并备份。 */
@font-face {
  font-family: "阿里妈妈刀隶体 Regular";
  font-weight: 400;
  src: url("https://at.alicdn.com/wf/webfont/5LuYNrGy8FTF/DrzsrAW85KGG.woff2") format("woff2"),
       url("https://at.alicdn.com/wf/webfont/5LuYNrGy8FTF/Q6gbUCjF6LWX.woff") format("woff");
  font-variation-settings: normal;
  font-display: swap;
}
@font-face {
  font-family: "阿里妈妈刀隶体 Regular 2";
  font-weight: 400;
  src: url("https://at.alicdn.com/wf/webfont/5LuYNrGy8FTF/2iUPjxwWJsgv.woff2") format("woff2"),
       url("https://at.alicdn.com/wf/webfont/5LuYNrGy8FTF/0YmgSqcioysB.woff") format("woff");
  font-variation-settings: normal;
  font-display: swap;
}
.webfont { font-family: "阿里妈妈刀隶体 Regular"; font-variation-settings: normal; }
.webfont2 { font-family: "阿里妈妈刀隶体 Regular 2"; font-variation-settings: normal; }

page {
  background: #f5f5f5;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

.spot-page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.spot-hero {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.spot-hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.spot-hero-badges {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  display: flex;
  gap: 12rpx;
  z-index: 2;
}
.spot-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}
.spot-badge-green { background: rgba(76, 175, 80, 0.92); }
.spot-badge-gold { background: linear-gradient(135deg, #f9a825, #f57f17); color: #fff; }

.spot-hero-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.25) 0%, transparent 40%, transparent 60%, rgba(0,0,0,0.5) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}

.spot-hero-title {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.4);
}

.spot-hero-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.95);
  margin-top: 12rpx;
}

.spot-experience {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.95);
}

.spot-body {
  margin: 20rpx 20rpx 32rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.spot-price-row { margin-bottom: 12rpx; }
.spot-price-row .spot-price { font-size: 40rpx; font-weight: 700; color: #2e7d32; }
.spot-title-row {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.spot-desc {
  font-size: 30rpx;
  color: #444;
  line-height: 1.65;
  margin-bottom: 24rpx;
}

.spot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.spot-tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(102, 187, 106, 0.18);
  color: #5a9a6e;
  font-size: 24rpx;
  font-weight: 600;
}

.spot-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee;
}
.spot-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.spot-date-tip { font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.spot-guides-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
}
.guide-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.guide-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  border: 3rpx solid transparent;
  margin-bottom: 20rpx;
}
.guide-card-selected {
  border-color: #ff9800;
  background: rgba(255, 152, 0, 0.08);
}
.guide-avatar {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5a9a6e, #2e7d32);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  margin: 0 auto 12rpx;
}
.guide-name { display: block; font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 4rpx; }
.guide-title { display: block; font-size: 22rpx; color: #ff9800; margin-bottom: 6rpx; }
.guide-intro { display: block; font-size: 22rpx; color: #666; line-height: 1.4; }

.spot-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.spot-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff5722;
}

.spot-price-unit {
  font-size: 26rpx;
  font-weight: 500;
  color: #999;
  margin-left: 4rpx;
}

.spot-book-btn {
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #ffb74d, #ff9800);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: none;
  box-shadow: 0 4rpx 14rpx rgba(255, 152, 0, 0.35);
}

.spot-book-btn::after { border: none; }

/* 预订弹窗 */
.book-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.book-modal {
  width: 100%;
  max-height: 75vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 28rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.book-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  text-align: center;
}
.book-modal-subtitle {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 24rpx;
}

.book-form {
  margin-bottom: 24rpx;
}

.book-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.book-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.book-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.book-input {
  flex: 1;
  font-size: 28rpx;
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.book-agree {
  margin-top: 20rpx;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #555;
}

.book-agree-label {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.book-agree-text {
  margin-left: 8rpx;
}

.book-agree-link {
  color: #1e5ea6;
  text-decoration: underline;
  margin: 0 4rpx;
}

.book-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.book-cancel,
.book-submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
  border: none;
}

.book-cancel {
  background: #f0f0f0;
  color: #666;
}

.book-cancel::after,
.book-submit::after { border: none; }

.book-submit {
  background: linear-gradient(135deg, #ffb74d, #ff9800);
  color: #fff;
  font-weight: 600;
}
