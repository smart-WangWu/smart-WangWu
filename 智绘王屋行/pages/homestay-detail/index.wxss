/* 民宿详情：大众点评式浅色信息流（复用 restaurant-detail 样式）*/
@import '../restaurant-detail/index.wxss';

/* ── 房型预订 ── */
.dp-room-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.dp-room-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.dp-room-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dp-room-left {
  flex: 1;
  min-width: 0;
}

.dp-room-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 6rpx;
}

.dp-room-desc {
  font-size: 22rpx;
  color: #888888;
  display: block;
}

.dp-room-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.dp-room-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff6633;
}

.dp-room-unit {
  font-size: 22rpx;
  color: #888888;
}

.dp-room-btn {
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a3d, #ff4d1a);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
}

/* ── 民宿特色 ── */
.dp-highlight {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.dp-tag-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dp-tag {
  font-size: 24rpx;
  color: #ff6633;
  background: #fff0ea;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* ── 预订弹窗 ── */
.dp-book-modal {
  padding: 32rpx 28rpx 40rpx;
}

.dp-book-room-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: #fff8f4;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.dp-book-room-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.dp-book-room-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff6633;
}

.dp-book-room-unit {
  font-size: 24rpx;
  color: #888888;
  font-weight: 400;
}

.dp-form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 16rpx;
}

.dp-form-row:last-of-type {
  border-bottom: none;
}

.dp-form-label {
  font-size: 28rpx;
  color: #666666;
  width: 80rpx;
  flex-shrink: 0;
}

.dp-form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  min-height: 0;
}

.dp-form-picker {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  padding: 8rpx 0;
}

.dp-form-picker--empty {
  color: #bbbbbb;
}

.dp-form-stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.dp-form-stepper-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5f5f5;
  color: #666666;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.dp-form-stepper-val {
  font-size: 28rpx;
  color: #1a1a1a;
  min-width: 32rpx;
  text-align: center;
}

.dp-form-agree {
  margin: 20rpx 0 28rpx;
}

.dp-form-agree-label {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
}

.dp-form-agree-text {
  font-size: 24rpx;
  color: #666666;
}

.dp-form-agree-link {
  font-size: 24rpx;
  color: #ff6633;
}

/* ── 付款弹窗 ── */
.dp-payment-modal {
  padding: 32rpx 28rpx 40rpx;
  text-align: center;
}

.dp-payment-amount {
  font-size: 56rpx;
  font-weight: 700;
  color: #ff6633;
  margin-bottom: 12rpx;
}

.dp-payment-tip {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 28rpx;
}

.dp-payment-qr {
  width: 360rpx;
  height: 360rpx;
  display: block;
  margin: 0 auto 28rpx;
  border-radius: 16rpx;
  background: #f8f8f8;
}
