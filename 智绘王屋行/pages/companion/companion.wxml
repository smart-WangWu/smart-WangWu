<!-- 随行客 - 小红书风格照片分享社区 -->
<view class="companion-page">

  <!-- 顶部标题栏 -->
  <view class="header-bar">
    <text class="header-title">随行客</text>
    <view class="header-search" bindtap="onSearchTap">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索笔记、话题...</text>
    </view>
  </view>

  <!-- 热门话题标签 -->
  <scroll-view class="topic-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="topic-list">
      <view 
        class="topic-item {{currentTopic === item.id ? 'active' : ''}}"
        wx:for="{{topicList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTopicTap"
      >
        <text class="topic-icon">{{item.icon}}</text>
        <text class="topic-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 照片瀑布流 -->
  <scroll-view 
    class="photo-feed"
    scroll-y="true"
    bindscrolltolower="onLoadMore"
    enhanced="true"
  >
    <view class="waterfall">
      <!-- 左列 -->
      <view class="waterfall-column left">
        <view 
          class="photo-card {{item.heightClass}}"
          wx:for="{{leftPhotos}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPhotoTap"
        >
          <image 
            class="photo-img" 
            src="{{item.image}}" 
            mode="widthFix"
            lazy-load="true"
          />
          <view class="photo-content">
            <text class="photo-title">{{item.title}}</text>
            <view class="photo-user">
              <image class="user-avatar" src="{{item.avatar}}" mode="aspectFill" />
              <text class="user-name">{{item.nickname}}</text>
            </view>
            <view class="photo-stats">
              <view class="stat-item">
                <text class="stat-icon">❤️</text>
                <text class="stat-num">{{item.likes}}</text>
              </view>
              <view class="stat-item">
                <text class="stat-icon">💬</text>
                <text class="stat-num">{{item.comments}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 右列 -->
      <view class="waterfall-column right">
        <view 
          class="photo-card {{item.heightClass}}"
          wx:for="{{rightPhotos}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPhotoTap"
        >
          <image 
            class="photo-img" 
            src="{{item.image}}" 
            mode="widthFix"
            lazy-load="true"
          />
          <view class="photo-content">
            <text class="photo-title">{{item.title}}</text>
            <view class="photo-user">
              <image class="user-avatar" src="{{item.avatar}}" mode="aspectFill" />
              <text class="user-name">{{item.nickname}}</text>
            </view>
            <view class="photo-stats">
              <view class="stat-item">
                <text class="stat-icon">❤️</text>
                <text class="stat-num">{{item.likes}}</text>
              </view>
              <view class="stat-item">
                <text class="stat-icon">💬</text>
                <text class="stat-num">{{item.comments}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载提示 -->
    <view class="load-more" wx:if="{{isLoading}}">
      <text class="loading-text">加载中...</text>
    </view>
    <view class="load-more" wx:if="{{noMore && photoList.length > 0}}">
      <text class="no-more-text">— 没有更多了 —</text>
    </view>
  </scroll-view>

  <!-- 发布按钮 -->
  <view class="publish-btn" bindtap="onPublishTap">
    <text class="publish-icon">+</text>
  </view>

</view>
