/* 随行客 - 小红书风格照片分享社区样式 */

.companion-page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* 顶部标题栏 */
.header-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.header-search {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #999;
}

/* 热门话题标签 */
.topic-scroll {
  background: #ffffff;
  white-space: nowrap;
}

.topic-list {
  display: inline-flex;
  padding: 20rpx 16rpx;
  gap: 16rpx;
}

.topic-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.topic-item.active {
  background: #ff2442;
  color: #ffffff;
}

.topic-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.topic-name {
  font-size: 26rpx;
  color: #666;
}

.topic-item.active .topic-name {
  color: #ffffff;
}

/* 照片瀑布流 */
.photo-feed {
  flex: 1;
  padding: 16rpx;
}

.waterfall {
  display: flex;
  justify-content: space-between;
}

.waterfall-column {
  width: calc(50% - 8rpx);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 照片卡片 */
.photo-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.photo-img {
  width: 100%;
  display: block;
}

.photo-content {
  padding: 16rpx;
}

.photo-title {
  display: block;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 用户信息 */
.photo-user {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.user-name {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 互动数据 */
.photo-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.stat-num {
  font-size: 22rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  padding: 32rpx;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.no-more-text {
  font-size: 24rpx;
  color: #ccc;
}

/* 发布按钮 */
.publish-btn {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #ff2442 0%, #ff6b81 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 36, 66, 0.4);
  z-index: 999;
}

.publish-btn:active {
  transform: scale(0.95);
}

.publish-icon {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1;
}
